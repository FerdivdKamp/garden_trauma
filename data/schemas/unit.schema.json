{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Unit definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "health", "speed", "reward", "tags"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "health": { "type": "number", "exclusiveMinimum": 0 },
    "speed": { "type": "number", "minimum": 0 },
    "reward": { "type": "integer", "minimum": 0 },
    "armor": {
      "type": "object",
      "propertyNames": { "enum": ["physical", "electric"] },
      "additionalProperties": { "type": "number", "minimum": -1, "maximum": 1 }
    },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ground", "air", "mechanical", "projectile", "physical", "electric"] } }
  }
}
