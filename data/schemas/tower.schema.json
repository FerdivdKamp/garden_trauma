{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tower definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "cost", "attack", "targeting", "tags"],
  "allOf": [
    {
      "if": {"properties": {"firing_mode": {"const": "lane"}}, "required": ["firing_mode"]},
      "then": {
        "required": ["detection_range"],
        "properties": {
          "detection_range": {"const": 0},
          "attack": {"properties": {"range": {"const": 0}}},
          "targeting": {"properties": {"priority": {"const": "lane"}}}
        }
      },
      "else": {
        "properties": {
          "detection_range": {"exclusiveMinimum": 0},
          "attack": {"properties": {"range": {"exclusiveMinimum": 0}}},
          "targeting": {"properties": {"priority": {"enum": ["first", "nearest", "last", "nearest_tile"]}}}
        }
      }
    },
    {
      "if": {"properties": {"firing_mode": {"const": "tile"}}, "required": ["firing_mode"]},
      "then": {
        "properties": {
          "attack": {"required": ["lava_damage_per_second", "puddle_radius"]},
          "targeting": {"properties": {"priority": {"const": "nearest_tile"}}}
        }
      },
      "else": {"properties": {"targeting": {"properties": {"priority": {"enum": ["first", "nearest", "last", "lane"]}}}}}
    }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "firing_mode": { "enum": ["targeted", "lane", "tile"] },
    "name": { "type": "string", "minLength": 1 },
    "cost": { "type": "integer", "minimum": 0 },
    "attack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["damage", "cooldown", "range", "projectile_speed"],
      "properties": {
        "damage": { "type": "number", "minimum": 0 },
        "cooldown": { "type": "number", "exclusiveMinimum": 0 },
        "range": { "type": "number", "minimum": 0 },
        "projectile_speed": { "type": "number", "exclusiveMinimum": 0 },
        "ball_count": { "type": "integer", "minimum": 1, "maximum": 6 },
        "homing_turn_speed": { "type": "number", "exclusiveMinimum": 0 },
        "projectile_lifetime": { "type": "number", "exclusiveMinimum": 0 },
        "bounce_height": { "type": "number", "minimum": 0 },
        "bounce_frequency": { "type": "number", "exclusiveMinimum": 0 },
        "lava_damage_per_second": { "type": "number", "minimum": 0 },
        "puddle_radius": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "targeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "priority"],
      "properties": {
        "targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ground", "air"] } },
        "priority": { "enum": ["first", "nearest", "last", "lane", "nearest_tile"] }
      }
    },
    "damage_type": { "enum": ["physical", "electric", "water"] },
    "detection_range": { "type": "number", "minimum": 0 },
    "turn_speed": { "type": "number", "minimum": 0 },
    "bonus_vs_tags": {
      "type": "object",
      "propertyNames": { "enum": ["ground", "air", "mechanical", "projectile", "physical", "electric", "water", "homing", "lane", "bouncing", "piercing"] },
      "additionalProperties": { "type": "number", "minimum": 0 }
    },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["ground", "air", "mechanical", "projectile", "physical", "electric", "water", "homing", "lane", "bouncing", "piercing"] } },
    "upgrades": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "cost", "attack"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "minLength": 1 },
          "cost": { "type": "integer", "minimum": 1 },
          "attack": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": {
              "damage": { "type": "number", "minimum": 0 },
              "cooldown": { "type": "number", "exclusiveMinimum": 0 },
              "range": { "type": "number", "exclusiveMinimum": 0 },
              "projectile_speed": { "type": "number", "exclusiveMinimum": 0 },
              "ball_count": { "type": "integer", "minimum": 1, "maximum": 6 },
              "lava_damage_per_second": { "type": "number", "minimum": 0 },
              "puddle_radius": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
